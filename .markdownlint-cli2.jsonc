{
  // このリポジトリは手書きの日本語ナレッジベース。以下のルールはこのリポジトリの
  // 意図的な書式(日本語の長い行・引用元の生URL・言語指定なしのプロンプトブロック・
  // プロンプト断片としての末尾スペースを含むコードスパン等)と衝突するため無効化する。
  // 執筆済みドキュメントは変更せず、環境側の設定で慣習を明示する。
  "config": {
    "default": true,
    "MD013": false, // 行長: 日本語プロースでは制限しない
    "MD034": false, // 生URL: 出典として意図的に記載
    "MD040": false, // コードブロックの言語指定: プロンプトは意図的にプレーン
    "MD041": false, // 先頭行の見出し: 指示ファイルは本文から始まる
    "MD036": false, // 強調を見出し代わり: 番号付きの小見出しとして使用
    "MD038": false, // コードスパン内の空白: `safe, ` 等はプロンプト断片で末尾空白が意味を持つ
    "MD012": false, // 連続空行
    "MD022": false, // 見出し前後の空行: 簡潔な記法を許容
    "MD032": false  // リスト前後の空行: 簡潔な記法を許容
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    // _archive は旧構成のアーカイブ(存在しない docs/*.md への既知の切れリンクを含む)。
    // アクティブな検証対象からは除外する。
    "_archive"
  ]
}
